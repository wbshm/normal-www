---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { apps, type App } from '../lib/apps';
import { site, locales, kinds, type ContentLocale } from '../data/site';
import { policyApps, policyLocales, type PolicyApp } from '../data/policies';
import { copy } from '../lib/i18n';
import { pagePath } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import Product from '../components/Product.astro';
import Document from '../components/Document.astro';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  const routes: { params: { path: string | undefined }; props: Props }[] = [];
  const usedEntries = new Set<string>();
  if (new Set(policyApps.map((app) => app.slug)).size !== policyApps.length) throw new Error('Policy app slugs must be unique.');
  function findEntry(slug: string, locale: ContentLocale, kind: CollectionEntry<'pages'>['data']['kind']) {
    const matching = entries.filter((entry) => entry.data.app === slug && entry.data.locale === locale && entry.data.kind === kind);
    if (matching.length !== 1) throw new Error(`Expected exactly one ${locale}/${slug}/${kind} Markdown document; found ${matching.length}.`);
    const entry = matching[0];
    if (kind === 'privacy' && !entry.data.updated) throw new Error(`${entry.id}: privacy policies require an effective date.`);
    usedEntries.add(entry.id);
    return entry;
  }
  for (const locale of locales) {
    routes.push({ params: { path: locale === 'en' ? undefined : 'zh' }, props: { locale } });
    for (const app of apps) {
      for (const kind of kinds) {
        const entry = findEntry(app.slug, locale, kind);
        const policyApp = kind === 'privacy' ? policyApps.find((policy) => policy.slug === app.slug) : undefined;
        routes.push({ params: { path: pagePath(locale, app.slug, kind).replace(/^\/|\/$/g, '') }, props: { locale, app, policyApp, entry } });
      }
    }
  }
  for (const policyApp of policyApps) {
    const app = apps.find((product) => product.slug === policyApp.slug);
    for (const locale of policyLocales(policyApp)) {
      if (app && locales.some((productLocale) => productLocale === locale)) continue;
      const entry = findEntry(policyApp.slug, locale, 'privacy');
      routes.push({ params: { path: pagePath(locale, policyApp.slug, 'privacy').replace(/^\/|\/$/g, '') }, props: { locale, app, policyApp, entry } });
    }
  }
  for (const entry of entries) {
    if (!usedEntries.has(entry.id)) throw new Error(`${entry.id}: document has no registered app, language, or page kind.`);
  }
  for (const app of [...apps, ...policyApps]) {
    const policies = entries.filter((entry) => entry.data.app === app.slug && entry.data.kind === 'privacy');
    if (new Set(policies.map((entry) => entry.data.updated)).size !== 1) throw new Error(`${app.slug}: all policy translations must share an effective date.`);
  }
  return routes;
}

interface Props { locale: ContentLocale; app?: App; policyApp?: PolicyApp; entry?: CollectionEntry<'pages'>; }
const { locale, app, policyApp, entry } = Astro.props;
const homeLocale = locale === 'ja' ? 'en' : locale;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const t = copy[homeLocale];
const title = entry ? `${entry.data.title} | ${site.name}` : `${site.name} — ${t.hero}${locale === 'en' ? ' ' : ''}${t.heroAccent}`;
const description = entry?.data.description ?? t.intro;
---
<Layout locale={locale} title={title} description={description} slug={app?.slug ?? policyApp?.slug} kind={entry?.data.kind} image={app?.icon} availableLocales={policyApp ? policyLocales(policyApp) : locales}>
  {!entry && <Home locale={homeLocale} />}
  {app && entry?.data.kind === 'overview' && Content && <Product app={app} locale={homeLocale}><Content /></Product>}
  {entry && entry.data.kind !== 'overview' && Content && <Document app={app} appName={policyApp?.names[locale]} locale={locale} kind={entry.data.kind} title={entry.data.title} description={entry.data.description} headings={rendered?.headings ?? []} updated={entry.data.updated}><Content /></Document>}
</Layout>
