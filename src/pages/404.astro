---
import Layout from '../layouts/Layout.astro';
import { pageUrl } from '../lib/urls';
---
<Layout locale="en" title="Page not found | Normal Apps" description="Find your way back to the apps, privacy policies, and support pages from Normal Apps." noindex>
  <section class="not-found container"><p class="eyebrow">404 / NOT FOUND</p><h1>This page took<br /><span class="serif-accent">a different turn.</span></h1><p>The address may be incomplete. Let’s get you back to our apps.</p><a class="button primary" href={pageUrl('en')}>Back to home <span aria-hidden="true">→</span></a><a class="text-link" href={pageUrl('zh')}>返回中文首页 <span aria-hidden="true">→</span></a></section>
</Layout>
