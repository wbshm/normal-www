---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { copy } from '../lib/i18n';
import { pageUrl } from '../lib/urls';
const t = copy.en;
---
<Layout locale="en" title={`${t.notFound} | ${site.name}`} description={t.notFoundBody} noindex>
  <section class="not-found container">
    <p class="error-code">404</p>
    <h1>{t.notFound}</h1>
    <p>{t.notFoundBody}</p>
    <div class="not-found-actions">
      <a class="button primary" href={pageUrl('en')}>{t.home}</a>
      <a class="button" href={pageUrl('zh')}>{copy.zh.home}</a>
    </div>
  </section>
</Layout>
