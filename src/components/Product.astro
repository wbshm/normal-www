---
import type { App } from '../lib/apps';
import { homeLocaleFor, type ProductLocale } from '../data/site';
import { copy } from '../lib/i18n';
import { pageUrl, withBase } from '../lib/urls';
import AppAction from './AppAction.astro';
import AppPageNav from './AppPageNav.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
interface Props { app: App; locale: ProductLocale; }
const { app, locale } = Astro.props;
const t = copy[locale];
const translation = app.locales[locale] ?? app.locales.en;
---
<div class="container product-page" data-app={app.slug} style={`--app-accent: ${app.accent}`}>
  <a class="breadcrumb" href={`${pageUrl(homeLocaleFor(locale))}#apps`}><span aria-hidden="true">←</span>{t.back}</a>
  <section class="product-hero">
    <div class="product-hero-copy">
      <div class="product-identity">
        <img class="app-icon" src={withBase(app.icon)} alt="" width="88" height="88" />
        <div>
          <div class="product-meta"><span>{t[app.category]} · {app.platform} · {app.requirement}</span></div>
          <h1>{translation.name}</h1>
          <p class="product-tagline">{translation.tagline}</p>
        </div>
      </div>
      <p class="product-description">{translation.description}</p>
      <div class="highlight-tags">{translation.highlights.map((item) => <span>{item}</span>)}</div>
    </div>
    <div class="product-hero-actions">
      <AppAction app={app} locale={locale} />
    </div>
  </section>
  <AppPageNav slug={app.slug} locale={locale} current="overview" />
  {app.screenshots.length > 0 && <ScreenshotGallery app={app} locale={locale} />}
  <section class="product-story prose"><slot /></section>
</div>
