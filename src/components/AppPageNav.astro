---
import { kinds, productLocaleFor, type ContentLocale, type PageKind } from '../data/site';
import { copy } from '../lib/i18n';
import { pageUrl } from '../lib/urls';

interface Props { slug: string; locale: ContentLocale; current: PageKind; }
const { slug, locale, current } = Astro.props;
const t = copy[locale];
const labels = { overview: t.about, privacy: t.privacy, support: t.support };
---
<nav class="app-page-nav" aria-label={t.appPages}>
  {kinds.map((kind) => <a href={pageUrl(kind === 'privacy' ? locale : productLocaleFor(locale), slug, kind)} aria-current={kind === current ? 'page' : undefined}>{labels[kind]}</a>)}
</nav>
