---
import { languageInfo, type Locale } from '../data/site';
import { policyApps, policyLocales } from '../data/policies';
import { apps, screenshotSource } from '../lib/apps';
import { copy } from '../lib/i18n';
import { pageUrl, withBase } from '../lib/urls';
import AppAction from './AppAction.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const visibleApps = apps.filter((app) => app.status !== 'archived');
const standalonePolicyApps = policyApps.filter((policy) => !apps.some((app) => app.slug === policy.slug));
---
<section class="home-hero container">
  <div class="home-intro">
    <h1>{t.hero}<br /><span>{t.heroAccent}</span></h1>
    <p>{t.intro}</p>
    <a class="home-cta" href="#apps">{t.explore}</a>
  </div>
  {visibleApps.length > 0 && <div class="home-art" aria-hidden="true">
    <div class="home-art-icons">
      {visibleApps.slice(0, 4).map((app) => <img src={withBase(app.icon)} alt="" width="104" height="104" />)}
    </div>
  </div>}
</section>
<section id="apps" class="home-catalog container" aria-labelledby="collection-heading">
  <h2 id="collection-heading">{t.collection}</h2>
  <div class="home-apps">
    {visibleApps.map((app, index) => {
      const translation = app.locales[locale];
      const url = pageUrl(locale, app.slug);
      return <article class="home-card" data-app={app.slug} style={`--app-accent: ${app.accent}`}>
        <div class="home-card-heading">
          <img src={withBase(app.icon)} alt="" width="56" height="56" loading={index < 2 ? 'eager' : 'lazy'} />
          <div>
            <h3><a href={url}>{translation.name}</a></h3>
            <p>{t[app.category]} · {app.requirement}</p>
          </div>
        </div>
        {app.screenshots.length > 0 && <a class="home-card-media" href={url} aria-label={`${t.details} · ${translation.name}`}>
          {app.screenshots.slice(0, 2).map((shot) => <img class:list={['home-shot', { 'home-shot--poster': app.screenshotStyle === 'poster' }]} src={withBase(screenshotSource(shot, locale))} alt={shot[locale]} width={shot.width} height={shot.height} loading={index < 2 ? 'eager' : 'lazy'} />)}
        </a>}
        <div class="home-card-body">
          <p>{translation.tagline}</p>
          <div class="home-card-actions">
            <a class="home-detail" href={url}>{t.details}</a>
            <AppAction app={app} locale={locale} />
          </div>
          <div class="home-card-links">
            <a href={pageUrl(locale, app.slug, 'privacy')}>{t.privacy}</a>
            <a href={pageUrl(locale, app.slug, 'support')}>{t.support}</a>
          </div>
        </div>
      </article>;
    })}
  </div>
</section>
{standalonePolicyApps.length > 0 && <section id="privacy-policies" class="policy-section container" aria-labelledby="policy-heading">
  <h2 id="policy-heading">{t.policyTitle}</h2>
  <p>{t.policyBody}</p>
  <div class="policy-list">{standalonePolicyApps.map((app) => <article class="policy-card"><h3><a href={pageUrl(locale, app.slug, 'privacy')}>{app.names[locale]}</a></h3><div class="policy-languages">{policyLocales(app).map((language) => <a href={pageUrl(language, app.slug, 'privacy')} lang={languageInfo[language].tag} hreflang={languageInfo[language].tag}>{languageInfo[language].label}</a>)}</div></article>)}</div>
</section>}

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.13fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(30px, 6vw, 86px);
    padding-block: clamp(38px, 5vw, 68px);
  }

  .home-intro h1 {
    font-size: clamp(3.2rem, 7vw, 6.25rem);
    line-height: 1.03;
  }

  .home-intro h1 span {
    color: #387869;
  }

  .home-intro h1:lang(zh-CN) {
    font-size: clamp(2.7rem, 5.9vw, 5.15rem);
    line-height: 1.16;
    letter-spacing: -.065em;
  }

  .home-intro p {
    margin-block: 19px 24px;
    max-width: 29rem;
    color: var(--muted);
    font-size: 1rem;
    text-wrap: pretty;
  }

  .home-cta,
  .home-detail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 9px 16px;
    border-radius: 9px;
    background: var(--ink);
    color: #fff;
    font-size: .875rem;
    font-weight: 600;
  }

  .home-cta:hover,
  .home-detail:hover {
    background: #276256;
    color: #fff;
  }

  .home-art {
    display: grid;
    min-height: clamp(240px, 30vw, 368px);
    place-items: center;
    overflow: hidden;
    border-radius: 26px;
    background:
      radial-gradient(ellipse at center, #a7d7ab1a, transparent 67%),
      radial-gradient(circle, #d4efe43d 1px, transparent 1.4px) center / 21px 21px,
      linear-gradient(145deg, #235e50, #133b31);
  }

  .home-art-icons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, clamp(66px, 8vw, 106px)));
    gap: clamp(12px, 2vw, 23px);
    transform: rotate(-9deg);
  }

  .home-art-icons img {
    width: 100%;
    border-radius: 24%;
    box-shadow: 0 10px 24px #081e1a66, 0 0 0 1px #ecfff33d;
  }

  .home-art-icons img:nth-child(even) {
    transform: translateY(8px);
  }

  .home-catalog {
    padding-top: clamp(8px, 2vw, 24px);
  }

  .home-catalog h2 {
    margin-bottom: 20px;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .home-apps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .home-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 20px;
    background-color: #fff;
  }

  .home-card-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 19px 22px;
  }

  .home-card-heading img {
    flex: 0 0 auto;
    border-radius: 14px;
  }

  .home-card-heading h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.13;
    overflow-wrap: anywhere;
  }

  .home-card-heading p {
    margin-top: 4px;
    color: var(--muted);
    font-size: .8125rem;
  }

  .home-card-media {
    display: grid;
    grid-auto-columns: minmax(0, 114px);
    grid-auto-flow: column;
    align-items: start;
    justify-content: center;
    gap: 14px;
    height: 178px;
    margin-inline: 12px;
    padding: 16px 20px 0;
    overflow: hidden;
    border-radius: 12px;
    background: var(--app-accent, var(--mint));
  }

  .home-shot {
    width: 100%;
    border: 3px solid #fff;
    border-radius: 15px;
    box-shadow: 0 8px 22px #183b3529;
  }

  .home-shot:nth-child(2) {
    margin-top: 12px;
  }

  .home-shot--poster {
    border: none;
    border-radius: 8px;
  }

  .home-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 17px 22px 19px;
  }

  .home-card-body > p {
    flex: 1;
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .home-card-actions,
  .home-card-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
  }

  .home-card-actions :global(.button) {
    min-height: 42px;
    padding: 9px 13px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-size: .875rem;
  }

  .home-card-actions :global(.button:hover) {
    background: #f0f7f2;
    border-color: #aac9bc;
  }

  .home-card-actions :global(.arrow) {
    display: none;
  }

  .home-card-actions :global(.release-status) {
    margin-top: 0;
    font-size: .8125rem;
  }

  .home-card-links {
    gap: 16px;
    color: var(--muted);
    font-size: .8125rem;
  }

  .home-card-links a {
    text-decoration: underline;
    text-decoration-color: #a2b6ad;
    text-underline-offset: .22em;
  }

  @media (max-width: 699px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 33px 34px;
    }

    .home-intro p {
      margin-block: 14px 18px;
    }

    .home-art {
      min-height: 120px;
      border-radius: 17px;
    }

    .home-art-icons {
      width: min(calc(100% - 32px), 280px);
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 52px);
      grid-template-columns: none;
      justify-content: center;
      gap: 14px;
      transform: none;
    }

    .home-art-icons img:nth-child(even) {
      transform: translateY(6px);
    }

    .home-apps {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .home-card-heading,
    .home-card-body {
      padding-inline: 17px;
    }
  }
</style>
