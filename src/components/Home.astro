---
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { apps } from '../lib/apps';
import { copy } from '../lib/i18n';
import { pageUrl, withBase } from '../lib/urls';
import Arrow from './Arrow.astro';
import AppAction from './AppAction.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const visibleApps = apps.filter((app) => app.status !== 'archived');
---
<section class="home-hero container">
  <div class="eyebrow"><span class="tiny-dot" aria-hidden="true"></span>{t.eyebrow}</div>
  <h1>{t.hero}<br /><span class="serif-accent">{t.heroAccent}</span></h1>
  <div class="hero-bottom"><p>{t.intro}</p><a class="text-link" href="#apps">{t.explore}<Arrow /></a></div>
  <svg class="hero-play-mark" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
    <path d="M28 126 65 44 113 94 142 49" fill="none" stroke="#7abbac" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="m51 46 28-5" fill="none" stroke="#ffcf49" stroke-width="10" stroke-linecap="round" />
    <path d="m99 97 28-6" fill="none" stroke="#96d8c4" stroke-width="10" stroke-linecap="round" />
    <circle cx="28" cy="126" r="10" fill="#ffcf49" />
  </svg>
</section>
<section id="apps" class="collection container" aria-labelledby="collection-heading">
  <div class="section-heading"><div><p class="eyebrow">{t.catalogue}</p><h2 id="collection-heading">{t.collection}</h2></div><span class="collection-count">{String(visibleApps.length).padStart(2, '0')}</span></div>
  <div class="app-collection">
    {visibleApps.map((app, index) => {
      const translation = app.locales[locale];
      return <article class="featured-app" data-app={app.slug} style={`--app-accent: ${app.accent}`}>
        <div class="featured-copy">
          <div class="product-meta"><span>{String(index + 1).padStart(2, '0')} / {t[app.category]}</span><span>{app.platform} · {app.requirement}</span></div>
          <img class="app-icon" src={withBase(app.icon)} alt={`${translation.name} ${locale === 'en' ? 'app icon' : '图标'}`} width="80" height="80" />
          <h3>{translation.name}</h3>
          <p class="product-tagline">{translation.tagline}</p>
          <p class="product-description">{translation.description}</p>
          <div class="highlight-tags">{translation.highlights.map((item) => <span>{item}</span>)}</div>
          <a class="button primary" href={pageUrl(locale, app.slug)}>{t.details}<Arrow /></a>
          <AppAction app={app} locale={locale} />
          <div class="product-legal-links"><a href={pageUrl(locale, app.slug, 'privacy')}>{t.privacy}</a><span aria-hidden="true">·</span><a href={pageUrl(locale, app.slug, 'support')}>{t.support}</a></div>
        </div>
        <a class="product-preview" href={pageUrl(locale, app.slug)} aria-label={`${t.details}: ${translation.name}`}>
          <span class="preview-circle" aria-hidden="true"></span>
          {app.screenshots.slice(0, 2).map((shot, i) => <img class={`phone-shot phone-${i}`} src={withBase(shot.src)} alt={`${translation.name} — ${shot[locale]}`} width="780" height="1688" loading="eager" />)}
          {app.screenshots.length === 0 && <img class="preview-icon" src={withBase(app.icon)} alt="" width="240" height="240" />}
          <span class="preview-note" aria-hidden="true">{translation.tagline}</span>
        </a>
      </article>;
    })}
  </div>
</section>
<section id="contact" class="contact-section container">
  <div class="contact-panel"><div><p class="eyebrow">{t.contactEyebrow}</p><h2>{t.contactTitle.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2></div><div class="contact-details"><p>{t.contactBody}</p><a href={`mailto:${site.email}?subject=Hello%20Normal%20Apps`}>{site.email}<Arrow diagonal /></a></div></div>
</section>
