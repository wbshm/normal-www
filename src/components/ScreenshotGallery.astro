---
import { screenshotSource, type App } from '../lib/apps';
import type { Locale } from '../data/site';
import { copy } from '../lib/i18n';
import { withBase } from '../lib/urls';

interface Props { app: App; locale: Locale; }
const { app, locale } = Astro.props;
const t = copy[locale];
const translation = app.locales[locale];
const firstShot = app.screenshots[0];
const lightboxId = `${app.slug}-lightbox`;
---
<section data-screenshot-gallery class:list={['screenshot-section', { 'poster-gallery': app.screenshotStyle === 'poster' }]}>
  <div class="section-heading">
    <h2 id="screenshots-heading">{t.screenshots}</h2>
  </div>
  <div class="screenshot-carousel" role="region" aria-labelledby="screenshots-heading" tabindex="0">
    {app.screenshots.map((shot) => <figure>
      <a class="screenshot-frame" data-screenshot-trigger data-caption={shot[locale]} href={withBase(screenshotSource(shot, locale))} aria-label={`${t.fullScreenshot}: ${shot[locale]}`}>
        <img src={withBase(screenshotSource(shot, locale))} alt={`${translation.name} — ${shot[locale]}`} width={shot.width} height={shot.height} loading="lazy" />
      </a>
      <figcaption>{shot[locale]}</figcaption>
    </figure>)}
  </div>
  {translation.screenshotNote && <p class="screenshot-note">{translation.screenshotNote}</p>}

  <dialog class="screenshot-lightbox" id={lightboxId} aria-labelledby={`${lightboxId}-title`}>
    <div class="lightbox-header">
      <div class="lightbox-label" aria-live="polite" aria-atomic="true">
        <span class="lightbox-counter" data-lightbox-counter>1 / {app.screenshots.length}</span>
        <p id={`${lightboxId}-title`} data-lightbox-caption>{firstShot[locale]}</p>
      </div>
      <button class="lightbox-button" type="button" data-lightbox-close aria-label={t.closeScreenshot} autofocus><span aria-hidden="true">×</span></button>
    </div>
    <div class="lightbox-body">
      <button class="lightbox-button" type="button" data-lightbox-prev aria-label={t.previousScreenshot} hidden={app.screenshots.length < 2}><span aria-hidden="true">←</span></button>
      <div class="lightbox-image-wrap">
        <img class="lightbox-image" data-lightbox-image src={withBase(screenshotSource(firstShot, locale))} alt={`${translation.name} — ${firstShot[locale]}`} width={firstShot.width} height={firstShot.height} loading="lazy" />
      </div>
      <button class="lightbox-button" type="button" data-lightbox-next aria-label={t.nextScreenshot} hidden={app.screenshots.length < 2}><span aria-hidden="true">→</span></button>
    </div>
  </dialog>
</section>
<script is:inline type="module" src={withBase('/scripts/screenshot-lightbox.js')}></script>
