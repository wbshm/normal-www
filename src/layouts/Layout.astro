---
import '../styles/global.css';
import { site, type Locale, type PageKind } from '../data/site';
import { copy } from '../lib/i18n';
import { withBase, pageUrl } from '../lib/urls';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  slug?: string;
  kind?: PageKind;
  image?: string;
  noindex?: boolean;
}
const { locale, title, description, slug, kind = 'overview', image = '/favicon.svg', noindex = false } = Astro.props;
const t = copy[locale];
const alternateLocale = locale === 'en' ? 'zh' : 'en';
const canonical = new URL(pageUrl(locale, slug, kind), site.url).href;
const imageUrl = new URL(withBase(image), site.url).href;
const email = `mailto:${site.email}?subject=${encodeURIComponent(slug ? `${slug} support` : 'Hello Normal Apps')}`;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfbf8" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={new URL(pageUrl('en', slug, kind), site.url).href} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(pageUrl('zh', slug, kind), site.url).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('en', slug, kind), site.url).href} />
    </>}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={noindex ? Astro.url.href : canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header container">
      <a class="brand" href={pageUrl(locale)} aria-label="Normal Apps">
        <img src={withBase('/favicon.svg')} alt="" width="35" height="35" />
        <span>Normal Apps<span class="brand-dot">.</span></span>
      </a>
      <nav class="main-nav" aria-label={locale === 'en' ? 'Main navigation' : '主导航'}>
        <a href={`${pageUrl(locale)}#apps`}>{t.apps}</a>
        <a href={email}>{t.contact}</a>
        <a class="language-switch" href={pageUrl(alternateLocale, slug, kind)} lang={alternateLocale === 'en' ? 'en' : 'zh-CN'} hreflang={alternateLocale === 'en' ? 'en' : 'zh-CN'} aria-label={alternateLocale === 'en' ? 'Read this page in English' : '用中文阅读此页'}>{t.switch}<span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div><a class="footer-brand" href={pageUrl(locale)}>Normal Apps.</a><p>{t.footer}</p></div>
      <div class="footer-end"><a href={email}>{site.email}</a><span>© {new Date().getUTCFullYear()} {t.rights}</span></div>
    </footer>
  </body>
</html>
