---
import '../styles/global.css';
import { site, locales, languageInfo, type ContentLocale, type PageKind } from '../data/site';
import { copy } from '../lib/i18n';
import { withBase, pageUrl } from '../lib/urls';
interface Props {
  locale: ContentLocale;
  availableLocales?: readonly ContentLocale[];
  title: string;
  description: string;
  slug?: string;
  kind?: PageKind;
  image?: string;
  noindex?: boolean;
  appBrand?: { name: string; href: string; icon?: string };
}
const { locale, title, description, slug, kind = 'overview', image = '/favicon.svg', noindex = false, availableLocales = locales, appBrand } = Astro.props;
const t = copy[locale];
const homeLocale = locale === 'ja' ? 'en' : locale;
const brand = appBrand ?? { name: site.name, href: pageUrl(homeLocale), icon: '/favicon.svg' };
const canonical = new URL(pageUrl(locale, slug, kind), site.url).href;
const imageUrl = new URL(withBase(image), site.url).href;
const email = `mailto:${site.email}?subject=${encodeURIComponent(slug ? `${slug} support` : `Hello ${site.name}`)}`;
---
<!doctype html>
<html lang={languageInfo[locale].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfbf8" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      {availableLocales.map((language) => <link rel="alternate" hreflang={languageInfo[language].tag} href={new URL(pageUrl(language, slug, kind), site.url).href} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('en', slug, kind), site.url).href} />
    </>}
    <link rel="icon" href={withBase(brand.icon ?? '/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={noindex ? Astro.url.href : canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={languageInfo[locale].og} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header container">
      <a class="brand" href={brand.href} aria-label={brand.name}>
        {brand.icon && <img src={withBase(brand.icon)} alt="" width="35" height="35" />}
        <span>{brand.name}</span>
      </a>
      <nav class:list={['main-nav', { 'multilingual-nav': availableLocales.length > 2 }]} aria-label={locale === 'en' ? 'Main navigation' : locale === 'ja' ? 'メインナビゲーション' : '主导航'}>
        <a href={`${pageUrl(homeLocale)}#apps`}>{t.apps}</a>
        <a href={email}>{t.contact}</a>
        <div class="language-options">{availableLocales.filter((language) => language !== locale).map((language) => <a class="language-switch" href={pageUrl(language, slug, kind)} lang={languageInfo[language].tag} hreflang={languageInfo[language].tag} aria-label={languageInfo[language].read}>{languageInfo[language].label}<span aria-hidden="true">↗</span></a>)}</div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div><a class="footer-brand" href={brand.href}>{brand.name}</a><p>{t.footer}</p></div>
      <div class="footer-end"><a href={email}>{site.email}</a><span>© {new Date().getUTCFullYear()} {appBrand?.name ?? t.rights}</span></div>
    </footer>
  </body>
</html>
