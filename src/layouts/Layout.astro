---
import '../styles/global.css';
import { site, locales, languageInfo, homeLocaleFor, type ContentLocale, type PageKind } from '../data/site';
import { copy } from '../lib/i18n';
import { withBase, pageUrl } from '../lib/urls';
interface Props {
  locale: ContentLocale;
  availableLocales?: readonly ContentLocale[];
  title: string;
  description: string;
  slug?: string;
  kind?: PageKind;
  image?: string;
  noindex?: boolean;
  homepage?: boolean;
  appBrand?: { name: string; href: string; icon?: string };
  canonicalPath?: string;
  alternateLinks?: readonly { locale: ContentLocale; href: string }[];
  appStoreId?: string;
  structuredData?: readonly Record<string, unknown>[];
}
const {
  locale,
  title,
  description,
  slug,
  kind = 'overview',
  image = '/favicon.svg',
  noindex = false,
  homepage = false,
  availableLocales = locales,
  appBrand,
  canonicalPath,
  alternateLinks,
  appStoreId,
  structuredData = [],
} = Astro.props;
const t = copy[locale];
const homeLocale = homeLocaleFor(locale);
const brand = appBrand ?? { name: site.name, href: pageUrl(homeLocale), icon: '/favicon.svg' };
const canonical = new URL(canonicalPath ? withBase(canonicalPath) : pageUrl(locale, slug, kind), site.url).href;
const resolvedAlternates = alternateLinks
  ? alternateLinks.map((item) => ({ locale: item.locale, href: withBase(item.href) }))
  : availableLocales.map((language) => ({ locale: language, href: pageUrl(language, slug, kind) }));
const defaultAlternate = resolvedAlternates.find((item) => item.locale === 'en') ?? resolvedAlternates[0];
const imageUrl = new URL(withBase(image), site.url).href;
const email = `mailto:${site.email}?subject=${encodeURIComponent(slug ? `${slug} support` : `Hello ${site.name}`)}`;
const copyright = `© ${new Date().getUTCFullYear()} ${appBrand?.name ?? t.rights}`;
const resolvedAppStoreId = appStoreId ?? (slug === 'dayweave' ? '6836203431' : undefined);
---
<!doctype html>
<html lang={languageInfo[locale].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfbf8" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {resolvedAppStoreId && <meta name="apple-itunes-app" content={`app-id=${resolvedAppStoreId}`} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      {resolvedAlternates.map((item) => <link rel="alternate" hreflang={languageInfo[item.locale].tag} href={new URL(item.href, site.url).href} />)}
      {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, site.url).href} />}
    </>}
    <link rel="icon" href={withBase(brand.icon ?? '/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={noindex ? Astro.url.href : canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={languageInfo[locale].og} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    {structuredData.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header container">
      <a class="brand" href={brand.href} aria-label={brand.name}>
        {brand.icon && <img src={withBase(brand.icon)} alt="" width="35" height="35" />}
        <span>{brand.name}</span>
      </a>
      <nav class:list={['main-nav', { 'multilingual-nav': resolvedAlternates.length > 2 }]} aria-label={t.mainNav}>
        <a href={`${pageUrl(homeLocale)}#apps`}>{t.apps}</a>
        {!homepage && <a class="nav-contact" href={email}>{t.contact}</a>}
        <div class="language-options">{resolvedAlternates.filter((item) => item.locale !== locale).map((item) => <a class="language-switch" href={item.href} lang={languageInfo[item.locale].tag} hreflang={languageInfo[item.locale].tag} aria-label={languageInfo[item.locale].read}>{languageInfo[item.locale].label}</a>)}</div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      {!homepage && <a class="footer-contact" href={email}>{site.email}</a>}
      <div class="footer-icp">
        <span>{copyright}</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" lang="zh-CN">{site.icpFilingNumber}</a>
      </div>
    </footer>
  </body>
</html>
